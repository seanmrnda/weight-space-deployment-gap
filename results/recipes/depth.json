[
 {
  "id": "H-noT-low",
  "rules": [
   {
    "match": "^encoder\\.layers\\.[0-7]\\.",
    "coefs": {
     "H": 1.0
    }
   },
   {
    "match": ".*",
    "coefs": {
     "H": 1.0,
     "T": 1.0,
     "L": -1.0
    }
   }
  ]
 },
 {
  "id": "H-noT-mid",
  "rules": [
   {
    "match": "^encoder\\.layers\\.(8|9|1[0-5])\\.",
    "coefs": {
     "H": 1.0
    }
   },
   {
    "match": ".*",
    "coefs": {
     "H": 1.0,
     "T": 1.0,
     "L": -1.0
    }
   }
  ]
 },
 {
  "id": "H-noT-high",
  "rules": [
   {
    "match": "^encoder\\.layers\\.(1[6-9]|2[01])\\.",
    "coefs": {
     "H": 1.0
    }
   },
   {
    "match": ".*",
    "coefs": {
     "H": 1.0,
     "T": 1.0,
     "L": -1.0
    }
   }
  ]
 },
 {
  "id": "H-halfT-experts",
  "rules": [
   {
    "match": "\\.experts\\.",
    "coefs": {
     "H": 1.0,
     "T": 0.5,
     "L": -0.5
    }
   },
   {
    "match": ".*",
    "coefs": {
     "H": 1.0,
     "T": 1.0,
     "L": -1.0
    }
   }
  ]
 },
 {
  "id": "H+.5(T-L)",
  "rules": [
   {
    "match": ".*",
    "coefs": {
     "H": 1.0,
     "T": 0.5,
     "L": -0.5
    }
   }
  ]
 },
 {
  "id": "mean(H,P)+T-L",
  "rules": [
   {
    "match": ".*",
    "coefs": {
     "H": 0.5,
     "P": 0.5,
     "T": 1.0,
     "L": -1.0
    }
   }
  ]
 }
]